{
  "ignoreCommand": "echo Git deployments are skipped. GitHub Actions deploys after tests.",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter ./ui build",
  "outputDirectory": "ui/dist",
  "devCommand": "pnpm --filter ./ui exec vite --port $PORT",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "deveshkrishan-github-io.vercel.app" }],
      "destination": "https://deveshkrishan.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "deveshkrishan-github-io.vercel.app" }],
      "destination": "https://deveshkrishan.com/:path*",
      "permanent": true
    }
  ]
}
